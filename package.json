{
  "name": "cc-bill",
  "version": "1.5.19",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "fixtures": "tsx scripts/fixtures/generate.ts",
    "fixtures:screens": "tsx scripts/fixtures/screens.ts",
    "lint": "eslint .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "test:mutation": "tsx scripts/mutation/run.ts",
    "test:mutation:changed": "tsx scripts/mutation/run.ts --base origin/main",
    "test:e2e:staging": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "dexie": "^3.2.7",
    "dexie-react-hooks": "^1.1.7",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "22.19.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "playwright": "1.63.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.72.1",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "2.1.9",
    "workbox-window": "^7.3.0"
